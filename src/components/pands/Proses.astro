---
const langkah = [
  {
    nomor: '01',
    judul: 'Ngobrol dulu',
    isi: 'Cerita soal usahamu lewat WhatsApp. Kami tanya alur kerjanya, bukan soal teknis. Gratis, tanpa kewajiban lanjut.',
  },
  {
    nomor: '02',
    judul: 'Lihat rancangan',
    isi: 'Kami kirim tampilan awal yang sudah memakai nama dan produk usahamu. Revisi dulu sampai cocok, baru dibangun.',
  },
  {
    nomor: '03',
    judul: 'Jalan dan diajari',
    isi: 'Setelah tayang, kami ajari cara mengubah isinya sendiri. Ada pendampingan 30 hari kalau ada yang bingung.',
  },
];
---

<section id="proses" class="border-t border-line bg-surface-alt py-14 sm:py-20">
  <div class="wrap">
    <h2 class="text-2xl sm:text-3xl">Cara kerjanya</h2>
    <p class="mt-2 max-w-xl text-ink-muted">
      Tiga langkah. Tidak ada istilah teknis yang perlu kamu pahami dulu.
    </p>

    <ol class="mt-8 grid gap-4 sm:grid-cols-3 sm:gap-5">
      {
        langkah.map((l) => (
          <li class="rounded-card border border-line bg-surface p-5">
            <span class="tabular font-display text-sm font-extrabold text-brand">
              {l.nomor}
            </span>
            <h3 class="mt-3 text-lg">{l.judul}</h3>
            <p class="mt-2 text-sm text-ink-muted">{l.isi}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
