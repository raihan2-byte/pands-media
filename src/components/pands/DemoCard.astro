---
import type { CollectionEntry } from 'astro:content';
import DemoPreview from './DemoPreview.astro';

interface Props {
  demo: CollectionEntry<'demos'>;
}

const { demo } = Astro.props;
const d = demo.data;
const siap = d.status === 'siap';
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-card border border-line bg-surface',
    'transition-shadow duration-200 motion-reduce:transition-none',
    siap && 'hover:shadow-card-hover',
  ]}
>
  <DemoPreview kategori={d.kategori} brandToken={d.brandToken} domainPalsu={d.domain} />

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">
        {d.kategori}
      </p>
      {
        !siap && (
          <span class="shrink-0 rounded-full bg-surface-alt px-2 py-0.5 text-[11px] font-semibold text-ink-muted">
            Segera
          </span>
        )
      }
    </div>

    <h3 class="mt-2 text-lg font-bold">
      {
        siap ? (
          /* Seluruh kartu bisa diklik lewat lapisan di bawah, tapi tautan
             aslinya tetap di judul supaya pembaca layar dan keyboard dapat
             satu target yang jelas. */
          <a href={d.url} class="after:absolute after:inset-0 after:content-['']">
            {d.brand}
          </a>
        ) : (
          d.brand
        )
      }
    </h3>

    <p class="mt-1.5 text-sm text-ink-muted">{d.tagline}</p>

    <p
      class:list={[
        'mt-4 flex items-center gap-1.5 text-sm font-semibold',
        siap ? 'text-brand' : 'text-ink-muted',
      ]}
    >
      {siap ? 'Buka demo' : 'Sedang dibangun'}
      {
        siap && (
          <svg
            aria-hidden="true"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none"
          >
            <path d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        )
      }
    </p>
  </div>
</article>
