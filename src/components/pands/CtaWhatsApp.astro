---
import Button from '../ui/Button.astro';
import { site, waLink } from '../../site';
---

<section id="kontak" class="border-t border-line bg-ink py-14 text-white sm:py-20">
  <div class="wrap">
    <div class="max-w-2xl">
      <p class="text-xs font-bold tracking-[0.14em] text-accent uppercase">
        Konsultasi gratis
      </p>
      <h2 class="mt-3 text-2xl text-white sm:text-3xl">
        Ceritakan usahamu. Kami jawab hari ini juga.
      </h2>
      <p class="mt-3 text-white/70">
        Tidak perlu siap-siap. Cukup bilang jualan apa dan bagian mana yang
        paling merepotkan sekarang. Kalau ternyata belum butuh website, kami
        bilang apa adanya.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <Button
          href={waLink('Halo Pands Media, saya mau konsultasi untuk usaha saya.')}
          variant="wa"
          size="lg"
          target="_blank"
          rel="noopener"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-5 shrink-0">
            <path
              d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.03-.2-.31a8.17 8.17 0 0 1-1.25-4.37c0-4.54 3.7-8.23 8.23-8.23a8.18 8.18 0 0 1 8.22 8.24c0 4.54-3.69 8.21-8.23 8.21Zm4.52-6.15c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.24-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.3-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.19 3.7.59.26 1.04.41 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"
            />
          </svg>
          Chat WhatsApp
        </Button>

        <a
          href={`mailto:${site.email}`}
          class="inline-flex min-h-11 items-center rounded-control border border-accent/50 px-6 py-3 text-base font-semibold text-accent transition-colors duration-200 hover:bg-accent/10 motion-reduce:transition-none"
        >
          Kirim email
        </a>
      </div>
    </div>
  </div>
</section>
