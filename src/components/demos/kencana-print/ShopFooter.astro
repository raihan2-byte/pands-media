---
import { toko, kategori } from '../../../data/kencana-print';

const base = '/porto/kencana-print';
const tahun = new Date().getFullYear();

const bantuan = [
  'Cara order',
  'Panduan ukuran & file',
  'Lacak pesanan',
  'Komplain & ganti cetak',
  'Syarat & ketentuan',
];
---

<footer class="mt-16 border-t border-line bg-surface-alt">
  <div class="wrap py-12">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <p class="flex items-center gap-2 font-display text-lg font-extrabold">
          <span
            class="grid size-8 place-items-center rounded-control bg-brand text-sm text-white"
            aria-hidden="true">K</span
          >
          Kencana<span class="-ml-1 text-brand">Print</span>
        </p>
        <p class="mt-3 text-sm text-ink-muted">
          Percetakan digital di {toko.kota}. Spanduk, stiker, kartu nama, sampai
          merchandise. Harga muncul sebelum kamu bertanya.
        </p>
        <p class="mt-4 text-sm">
          <span class="block font-semibold">{toko.telepon}</span>
          <span class="block text-ink-muted">{toko.email}</span>
        </p>
      </div>

      <div>
        <h3 class="text-sm font-bold">Kategori</h3>
        <ul class="mt-3 flex flex-col gap-1 text-sm">
          {
            kategori.map((k) => (
              <li>
                <a
                  href={`${base}/produk?kategori=${k.slug}`}
                  class="inline-block py-1 text-ink-muted hover:text-brand"
                >
                  {k.nama}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold">Bantuan</h3>
        <ul class="mt-3 flex flex-col gap-1 text-sm">
          {
            bantuan.map((b) => (
              <li>
                <span class="inline-block py-1 text-ink-muted">{b}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div id="jam">
        <h3 class="text-sm font-bold">Jam layanan</h3>
        <dl class="mt-3 flex flex-col gap-1 text-sm">
          {
            toko.jam.map((j) => (
              <div class="flex justify-between gap-3 py-0.5">
                <dt class="text-ink-muted">{j.hari}</dt>
                <dd class="tabular font-medium">{j.buka}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 text-sm text-ink-muted">{toko.alamat}</p>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-line pt-6 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {tahun} {toko.nama}. Semua harga sudah termasuk PPN.</p>
      <p>
        Mockup buatan <a href="/porto" class="font-semibold text-brand">Pands Media</a>.
        Toko ini tidak nyata.
      </p>
    </div>
  </div>
</footer>
