---
import { langkahOrder } from '../../../data/kencana-print';
---

<section id="cara-order" class="mt-8 border-y border-line bg-surface-alt py-12">
  <div class="wrap">
    <h2 class="text-xl sm:text-2xl">Cara pesan</h2>
    <p class="mt-1 text-sm text-ink-muted">Lima langkah, selesai dari rumah.</p>

    <ol class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {
        langkahOrder.map((l, i) => (
          <li class="rounded-card border border-line bg-surface p-4">
            <span class="tabular grid size-7 place-items-center rounded-full bg-brand text-xs font-bold text-white">
              {i + 1}
            </span>
            <h3 class="mt-3 text-base">{l.judul}</h3>
            <p class="mt-1 text-sm text-ink-muted">{l.isi}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
