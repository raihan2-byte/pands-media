---
import { Image } from 'astro:assets';
import hero from '../../../assets/kencana-print/hero-cetak.jpg';
import ProductPhoto from './ProductPhoto.astro';

const base = '/porto/kencana-print';
---

<section class="wrap pt-5 pb-8">
  <div class="grid gap-3 lg:grid-cols-[2fr_1fr]">
    {/* Banner utama: foto mesin cetak, teks di atas lapisan ungu. */}
    <div class="relative isolate overflow-hidden rounded-card px-6 py-10 text-white sm:px-10 sm:py-14">
      <Image
        src={hero}
        alt=""
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1024px) 66vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />
      {/* Lapisan gelap supaya teks tetap terbaca di atas foto apa pun. */}
      <div
        class="absolute inset-0 -z-10 bg-linear-to-r from-brand-strong/95 via-brand/85 to-brand/60"
        aria-hidden="true"
      >
      </div>

      <p class="text-xs font-bold tracking-[0.14em] text-white/75 uppercase">
        Percetakan digital Yogyakarta
      </p>
      <h1 class="mt-3 max-w-md text-2xl text-white sm:text-3xl lg:text-4xl">
        Hitung dulu harganya. Baru pesan.
      </h1>
      <p class="mt-3 max-w-sm text-sm text-white/85 sm:text-base">
        Pilih ukuran dan bahan, biayanya langsung muncul. Tidak perlu chat dulu
        cuma untuk tanya spanduk 3 × 1 berapa.
      </p>
      <div class="mt-6 flex flex-wrap gap-2.5">
        <a
          href={`${base}/produk/spanduk-mmt`}
          class="inline-flex min-h-11 items-center rounded-control bg-accent px-5 text-sm font-bold text-accent-strong hover:brightness-95"
        >
          Hitung harga spanduk
        </a>
        <a
          href={`${base}/produk`}
          class="inline-flex min-h-11 items-center rounded-control border border-white/40 px-5 text-sm font-semibold text-white hover:bg-white/10"
        >
          Lihat semua produk
        </a>
      </div>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
      <a
        href={`${base}/produk/print-a4`}
        class="flex items-center gap-4 rounded-card border border-line bg-surface p-4 transition-shadow duration-200 hover:shadow-card-hover motion-reduce:transition-none"
      >
        <ProductPhoto
          slug="print-a4"
          class="size-16 shrink-0 rounded-control"
          widths={[128, 256]}
          sizes="64px"
        />
        <span>
          <span class="block text-sm font-bold">Print ditunggu</span>
          <span class="block text-xs text-ink-muted">A4 hitam putih mulai Rp700/lembar</span>
        </span>
      </a>
      <a
        href={`${base}/produk/mug-custom`}
        class="flex items-center gap-4 rounded-card border border-line bg-surface p-4 transition-shadow duration-200 hover:shadow-card-hover motion-reduce:transition-none"
      >
        <ProductPhoto
          slug="mug-custom"
          class="size-16 shrink-0 rounded-control"
          widths={[128, 256]}
          sizes="64px"
        />
        <span>
          <span class="block text-sm font-bold">Merchandise satuan</span>
          <span class="block text-xs text-ink-muted">Mug, kaos, totebag. Boleh pesan 1 biji</span>
        </span>
      </a>
    </div>
  </div>
</section>
