---
import { toko, kategori } from '../../../data/kencana-print';

const base = '/porto/kencana-print';
const path = Astro.url.pathname;
const aktif = (href: string) =>
  href === base ? path === base || path === `${base}/` : path.startsWith(href);

const nav = [
  { label: 'Beranda', href: base },
  { label: 'Semua Produk', href: `${base}/produk` },
  { label: 'Cara Order', href: `${base}#cara-order` },
  { label: 'Jam Layanan', href: `${base}#jam` },
];
---

{/* Baris paling atas: info singkat yang di percetakan selalu ditanya duluan. */}
<div class="bg-brand-strong text-white">
  <div class="wrap flex h-9 items-center justify-between gap-4 text-xs">
    <p class="truncate">
      Gratis antar dalam kota untuk pesanan di atas {' '}
      <strong class="font-semibold">Rp150.000</strong>
    </p>
    <p class="hidden shrink-0 sm:block">
      {toko.kota} &middot; {toko.telepon}
    </p>
  </div>
</div>

<header class="sticky top-11 z-30 border-b border-line bg-surface">
  <div class="wrap flex h-16 items-center gap-3 sm:gap-5">
    <a href={base} class="flex shrink-0 items-center gap-2">
      <span
        class="grid size-9 place-items-center rounded-control bg-brand font-display text-base font-extrabold text-white"
        aria-hidden="true">K</span
      >
      <span class="font-display text-lg leading-none font-extrabold tracking-tight">
        Kencana<span class="text-brand">Print</span>
      </span>
    </a>

    {/* Pencarian mengarah ke halaman produk, lalu disaring di sana. */}
    <form action={`${base}/produk`} method="get" class="relative hidden flex-1 md:block">
      <label for="cari-atas" class="sr-only">Cari produk cetak</label>
      <input
        id="cari-atas"
        type="search"
        name="q"
        placeholder="Mau cetak apa hari ini?"
        class="h-10 w-full rounded-control border border-line bg-surface-alt pr-11 pl-4 text-sm outline-none placeholder:text-ink-muted focus:border-brand focus:bg-surface"
      />
      <button
        type="submit"
        class="absolute top-1 right-1 grid size-8 place-items-center rounded-control bg-brand text-white"
        aria-label="Cari"
      >
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="size-4">
          <circle cx="9" cy="9" r="6"></circle>
          <path d="m14 14 4 4" stroke-linecap="round"></path>
        </svg>
      </button>
    </form>

    <a
      href={`${base}/produk`}
      class="ml-auto inline-flex min-h-11 items-center rounded-control px-3 text-sm font-semibold text-ink-muted hover:text-brand md:hidden"
    >
      Produk
    </a>

    <a
      href={`https://wa.me/${toko.whatsapp}?text=${encodeURIComponent('Halo Kencana Print, saya mau pesan cetak.')}`}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-control bg-accent px-4 text-sm font-bold text-accent-strong transition-colors duration-200 hover:brightness-95 motion-reduce:transition-none"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="size-4 shrink-0" aria-hidden="true">
        <path
          d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.03-.2-.31a8.17 8.17 0 0 1-1.25-4.37c0-4.54 3.7-8.23 8.23-8.23a8.18 8.18 0 0 1 8.22 8.24c0 4.54-3.69 8.21-8.23 8.21Zm4.52-6.15c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.24-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.3-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.19 3.7.59.26 1.04.41 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"
        ></path>
      </svg>
      <span class="hidden sm:inline">Pesan cepat</span>
      <span class="sm:hidden">Pesan</span>
    </a>
  </div>

  {/* Baris kategori. Bisa digeser di layar kecil. */}
  <nav aria-label="Kategori produk" class="border-t border-line">
    <div class="wrap flex gap-1 overflow-x-auto py-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {
        nav.map((n) => (
          <a
            href={n.href}
            aria-current={aktif(n.href) ? 'page' : undefined}
            class:list={[
              'shrink-0 rounded-control px-3 py-2 text-sm font-semibold whitespace-nowrap',
              aktif(n.href) ? 'bg-brand-soft text-brand-strong' : 'text-ink-muted hover:text-ink',
            ]}
          >
            {n.label}
          </a>
        ))
      }
      <span class="my-2 w-px shrink-0 bg-line" aria-hidden="true"></span>
      {
        kategori.map((k) => (
          <a
            href={`${base}/produk?kategori=${k.slug}`}
            class="shrink-0 rounded-control px-3 py-2 text-sm whitespace-nowrap text-ink-muted hover:text-brand"
          >
            {k.nama}
          </a>
        ))
      }
    </div>
  </nav>
</header>
