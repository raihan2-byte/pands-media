---
import type { Produk } from '../../../data/rumah-hijab';
import { rupiah } from '../../../data/rumah-hijab';
import Foto from './Foto.astro';

interface Props {
  produk: Produk;
  prioritas?: boolean;
}

const { produk: p, prioritas = false } = Astro.props;
const base = '/porto/rumah-hijab';
const diskon = p.hargaCoret ? Math.round((1 - p.harga / p.hargaCoret) * 100) : 0;
---

<article class="group relative flex flex-col">
  <div class="relative overflow-hidden rounded-card">
    <Foto
      slug={p.slug}
      prioritas={prioritas}
      class="aspect-4/5 transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
    />
    {
      p.label && (
        <span class="absolute top-3 left-3 rounded-full bg-surface/95 px-3 py-1 text-[11px] font-semibold text-brand-strong">
          {p.label}
        </span>
      )
    }
    {
      diskon > 0 && (
        <span class="absolute top-3 right-3 rounded-full bg-brand px-2.5 py-1 text-[11px] font-bold text-white">
          &minus;{diskon}%
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col pt-3">
    <h3 class="font-display text-base leading-snug">
      <a href={`${base}/produk/${p.slug}`} class="after:absolute after:inset-0 after:content-['']">
        {p.nama}
      </a>
    </h3>
    <p class="mt-1 text-xs text-ink-muted">{p.ringkas}</p>

    <p class="mt-auto flex items-baseline gap-2 pt-2.5">
      <span class="tabular font-semibold text-brand">{rupiah(p.harga)}</span>
      {
        p.hargaCoret && (
          <span class="tabular text-xs text-ink-muted line-through">
            {rupiah(p.hargaCoret)}
          </span>
        )
      }
    </p>

    <p class="tabular mt-1 flex items-center gap-1.5 text-[11px] text-ink-muted">
      <svg viewBox="0 0 20 20" class="size-3.5 fill-accent" aria-hidden="true">
        <path d="M10 1.8l2.4 5 5.5.8-4 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4-4-3.8 5.5-.8 2.4-5z"></path>
      </svg>
      {p.rating.toFixed(1)} · {p.terjual.toLocaleString('id-ID')} terjual
    </p>
  </div>
</article>
