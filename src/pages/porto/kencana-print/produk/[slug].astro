---
import KencanaLayout from '../../../../layouts/KencanaLayout.astro';
import ProductPhoto from '../../../../components/demos/kencana-print/ProductPhoto.astro';
import ProductCard from '../../../../components/demos/kencana-print/ProductCard.astro';
import Rating from '../../../../components/demos/kencana-print/Rating.astro';
import FormPesanan from '../../../../components/demos/kencana-print/FormPesanan.tsx';
import { produk, kategori, toko, rupiah, labelSatuan } from '../../../../data/kencana-print';

export function getStaticPaths() {
  return produk.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const base = '/porto/kencana-print';
const namaKategori = kategori.find((k) => k.slug === p.kategori)?.nama ?? p.kategori;
const lainnya = produk.filter((x) => x.kategori === p.kategori && x.slug !== p.slug).slice(0, 4);
---

<KencanaLayout title={p.nama} description={p.ringkas}>
  <div class="wrap py-6">
    <nav aria-label="Remah roti" class="text-sm text-ink-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={base} class="hover:text-brand">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={`${base}/produk?kategori=${p.kategori}`} class="hover:text-brand">
            {namaKategori}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">{p.nama}</li>
      </ol>
    </nav>

    <div class="mt-5 grid gap-6 lg:grid-cols-2 lg:gap-10">
      <div>
        <ProductPhoto
          slug={p.slug}
          prioritas
          class="aspect-4/3 rounded-card border border-line"
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 560px, 100vw"
        />

        {
          lainnya.length > 0 && (
            <div class="mt-4">
              <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">
                Hasil cetak lain di kategori ini
              </p>
              <div class="mt-2 grid grid-cols-3 gap-2">
                {lainnya.slice(0, 3).map((x) => (
                  <a href={`${base}/produk/${x.slug}`} class="group block">
                    <ProductPhoto
                      slug={x.slug}
                      class="aspect-square rounded-control border border-line"
                      widths={[160, 320]}
                      sizes="140px"
                    />
                    <span class="mt-1.5 block truncate text-xs text-ink-muted group-hover:text-brand">
                      {x.nama}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <div class="mt-6">
          <h2 class="text-lg">Keterangan</h2>
          <p class="mt-2 text-sm text-ink-muted">{p.deskripsi}</p>

          <dl class="mt-5 grid gap-3 sm:grid-cols-2">
            <div class="rounded-card border border-line p-3">
              <dt class="text-xs text-ink-muted">Lama pengerjaan</dt>
              <dd class="mt-0.5 font-semibold">{p.lamaKerja}</dd>
            </div>
            <div class="rounded-card border border-line p-3">
              <dt class="text-xs text-ink-muted">Minimal pesan</dt>
              <dd class="mt-0.5 font-semibold">
                {p.minimal} {p.satuan === 'm2' ? 'lembar' : p.satuan}
              </dd>
            </div>
          </dl>

          {
            p.bahan && (
              <div class="mt-5">
                <h3 class="text-base">Pilihan bahan</h3>
                <ul class="mt-2 flex flex-col gap-2 text-sm">
                  {p.bahan.map((b) => (
                    <li class="flex gap-2">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                      <span>
                        <strong class="font-semibold">{b.nama}</strong>
                        {b.catatan && <span class="text-ink-muted"> — {b.catatan}</span>}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>

      <div class="lg:sticky lg:top-36 lg:self-start">
        <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">
          {namaKategori}
        </p>
        <h1 class="mt-1.5 text-2xl sm:text-3xl">{p.nama}</h1>
        <Rating nilai={p.rating} ulasan={p.ulasan} class="mt-2" />
        <p class="mt-3 text-sm text-ink-muted">{p.ringkas}</p>

        <p class="mt-4 flex items-baseline gap-1.5">
          <span class="tabular font-display text-3xl font-extrabold text-brand-strong">
            {rupiah(p.harga)}
          </span>
          <span class="text-sm text-ink-muted">{labelSatuan[p.satuan]}</span>
        </p>

        <div class="mt-5">
          {/* Pulau React. Hanya bagian ini yang mengirim JavaScript ke browser. */}
          <FormPesanan client:load produk={p} whatsapp={toko.whatsapp} />
        </div>
      </div>
    </div>

    {
      lainnya.length > 0 && (
        <section class="mt-12">
          <h2 class="text-xl">Masih satu kategori</h2>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {lainnya.map((x) => (
              <ProductCard produk={x} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</KencanaLayout>
