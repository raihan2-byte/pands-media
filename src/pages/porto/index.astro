---
import { getCollection } from 'astro:content';
import PandsLayout from '../../layouts/PandsLayout.astro';
import DemoPreview from '../../components/pands/DemoPreview.astro';
import Button from '../../components/ui/Button.astro';
import { waLink } from '../../site';

/* Demo yang sudah bisa dibuka tampil lebih dulu. */
const demos = (await getCollection('demos')).sort((a, b) => {
  const siap = Number(b.data.status === 'siap') - Number(a.data.status === 'siap');
  return siap !== 0 ? siap : a.data.urutan - b.data.urutan;
});

const jumlahSiap = demos.filter((d) => d.data.status === 'siap').length;
const kategori = [...new Set(demos.map((d) => d.data.kategori))];
---

<PandsLayout
  title="Portofolio"
  description="Demo website dan aplikasi yang bisa dikerjakan Pands Media untuk UMKM: percetakan, kasir, inventory, toko online, dan profil perusahaan."
>
  <section class="wrap pt-10 pb-8 sm:pt-14">
    <p class="text-xs font-semibold tracking-[0.12em] text-brand uppercase">Portofolio</p>
    <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl lg:text-5xl">
      Buka, klik-klik, pakai seperti punya sendiri.
    </h1>
    <p class="mt-4 max-w-xl text-base text-ink-muted sm:text-lg">
      Tiap demo di bawah adalah situs atau aplikasi utuh dengan nama usaha
      fiktif dan brandingnya sendiri. Bukan gambar, bukan video.
    </p>

    <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-5 text-sm">
      <div class="flex items-baseline gap-2">
        <dt class="text-ink-muted">Bisa dicoba sekarang</dt>
        <dd class="tabular font-bold">{jumlahSiap}</dd>
      </div>
      <div class="flex items-baseline gap-2">
        <dt class="text-ink-muted">Sedang dibangun</dt>
        <dd class="tabular font-bold">{demos.length - jumlahSiap}</dd>
      </div>
      <div class="flex items-baseline gap-2">
        <dt class="text-ink-muted">Jenis sistem</dt>
        <dd class="tabular font-bold">{kategori.length}</dd>
      </div>
    </dl>
  </section>

  <section class="wrap pb-16 sm:pb-24">
    {/* Penyaring kategori. Kartunya sudah tercetak di HTML, skrip di bawah
        hanya menyembunyikan yang tidak cocok — jadi daftar tetap lengkap
        kalau JavaScript gagal dimuat. */}
    <div
      class="flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      role="group"
      aria-label="Saring menurut jenis"
    >
      <button
        type="button"
        data-saring="semua"
        aria-pressed="true"
        class="saring min-h-11 shrink-0 rounded-full border border-line px-4 text-sm font-semibold whitespace-nowrap"
      >
        Semua
      </button>
      {
        kategori.map((k) => (
          <button
            type="button"
            data-saring={k}
            aria-pressed="false"
            class="saring min-h-11 shrink-0 rounded-full border border-line px-4 text-sm font-semibold whitespace-nowrap"
          >
            {k}
          </button>
        ))
      }
    </div>

    <p id="hasil" aria-live="polite" class="mt-5 text-sm text-ink-muted">
      Menampilkan {demos.length} demo.
    </p>

    <ul id="daftar" class="mt-4 grid gap-5 lg:grid-cols-2">
      {
        demos.map((demo) => {
          const d = demo.data;
          const siap = d.status === 'siap';
          return (
            <li class="demo" data-kategori={d.kategori}>
              <article
                class:list={[
                  'group relative flex h-full flex-col overflow-hidden rounded-card border border-line bg-surface',
                  'transition-shadow duration-200 motion-reduce:transition-none',
                  siap && 'hover:shadow-card-hover',
                ]}
              >
                <DemoPreview
                  kategori={d.kategori}
                  brandToken={d.brandToken}
                  domainPalsu={d.domain}
                />

                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-start justify-between gap-3">
                    <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">
                      {d.kategori}
                    </p>
                    <span
                      class:list={[
                        'shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-bold',
                        siap
                          ? 'bg-brand-soft text-brand-strong'
                          : 'bg-surface-alt text-ink-muted',
                      ]}
                    >
                      {siap ? 'Bisa dicoba' : 'Segera'}
                    </span>
                  </div>

                  <h2 class="mt-2 text-xl">
                    {siap ? (
                      <a href={d.url} class="after:absolute after:inset-0 after:content-['']">
                        {d.brand}
                      </a>
                    ) : (
                      d.brand
                    )}
                  </h2>

                  <p class="mt-1.5 text-sm font-medium text-ink-muted">{d.tagline}</p>
                  <p class="mt-3 text-sm text-ink-muted">{d.ringkasan}</p>

                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {d.fitur.map((f) => (
                      <li class="rounded-full border border-line px-2.5 py-1 text-xs text-ink-muted">
                        {f}
                      </li>
                    ))}
                  </ul>

                  <p
                    class:list={[
                      'mt-5 flex items-center gap-1.5 text-sm font-semibold',
                      siap ? 'text-brand' : 'text-ink-muted',
                    ]}
                  >
                    {siap ? `Buka ${d.domain ?? 'demo'}` : 'Sedang dibangun'}
                    {siap && (
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-4 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none"
                      >
                        <path d="M3 8h10M9 4l4 4-4 4" />
                      </svg>
                    )}
                  </p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>

    <p
      id="kosong"
      hidden
      class="mt-6 rounded-card border border-line bg-surface-alt p-6 text-sm"
    >
      Belum ada demo di jenis itu.
      <button type="button" data-saring="semua" class="saring font-semibold text-brand">
        Tampilkan semua
      </button>
    </p>

    {/* Penutup: apa yang tidak kelihatan dari kartu di atas. */}
    <div class="mt-10 grid gap-5 rounded-card border border-line bg-surface-alt p-6 sm:p-8 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <h2 class="text-xl sm:text-2xl">Yang perlu kamu tahu soal demo ini</h2>
        <ul class="mt-4 flex flex-col gap-3 text-sm text-ink-muted">
          <li class="flex gap-2.5">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
            <span>
              Semua nama usaha, harga, dan foto di dalamnya fiktif. Tidak ada
              pesanan atau pembayaran yang benar-benar diproses.
            </span>
          </li>
          <li class="flex gap-2.5">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
            <span>
              Demo aplikasi seperti kasir menyimpan datanya di browser kamu
              saja. Muat ulang halaman, semuanya kembali ke awal.
            </span>
          </li>
          <li class="flex gap-2.5">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
            <span>
              Tiap demo punya warna, font, dan nama sendiri. Punyamu nanti juga
              begitu, bukan template yang diganti teksnya.
            </span>
          </li>
        </ul>
      </div>

      <div class="flex flex-col justify-center gap-3 rounded-card bg-ink p-6 text-white">
        <p class="text-xs font-bold tracking-[0.14em] text-accent uppercase">
          Mau yang seperti ini?
        </p>
        <p class="text-lg leading-snug font-semibold">
          Bilang jualan apa, kami carikan bentuk yang pas.
        </p>
        <Button
          href={waLink('Halo Pands Media, saya habis lihat portofolio. Saya mau tanya untuk usaha saya.')}
          variant="wa"
          target="_blank"
          rel="noopener"
          class="mt-1 w-full"
        >
          Chat WhatsApp
        </Button>
      </div>
    </div>
  </section>
</PandsLayout>

<script>
  // Penyaring kategori. Bekerja pada kartu yang sudah ada di halaman.
  const tombol = Array.from(document.querySelectorAll<HTMLButtonElement>('.saring'));
  const kartu = Array.from(document.querySelectorAll<HTMLElement>('.demo'));
  const hasil = document.getElementById('hasil');
  const kosong = document.getElementById('kosong');

  function setAktif(nilai: string) {
    let tampil = 0;

    for (const k of kartu) {
      const cocok = nilai === 'semua' || k.dataset.kategori === nilai;
      k.hidden = !cocok;
      if (cocok) tampil++;
    }

    for (const t of tombol) {
      const aktif = t.dataset.saring === nilai && t.classList.contains('shrink-0');
      t.setAttribute('aria-pressed', String(aktif));
      t.classList.toggle('bg-brand', aktif);
      t.classList.toggle('text-white', aktif);
      t.classList.toggle('border-brand', aktif);
    }

    if (hasil) {
      hasil.textContent =
        nilai === 'semua'
          ? `Menampilkan ${tampil} demo.`
          : `Menampilkan ${tampil} demo untuk ${nilai}.`;
    }
    if (kosong) kosong.hidden = tampil !== 0;
  }

  for (const t of tombol) {
    t.addEventListener('click', () => setAktif(t.dataset.saring ?? 'semua'));
  }

  setAktif(new URLSearchParams(location.search).get('jenis') ?? 'semua');
</script>
