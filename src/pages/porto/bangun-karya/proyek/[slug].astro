---
import BangunLayout from '../../../../layouts/BangunLayout.astro';
import Foto from '../../../../components/demos/bangun-karya/Foto.astro';
import KartuProyek from '../../../../components/demos/bangun-karya/KartuProyek.astro';
import { proyek, jenisProyek, perusahaan } from '../../../../data/bangun-karya';

export function getStaticPaths() {
  return proyek.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const base = '/porto/bangun-karya';
const jenis = jenisProyek.find((j) => j.slug === p.jenis)!.nama;
const serupa = proyek.filter((x) => x.jenis === p.jenis && x.slug !== p.slug).slice(0, 3);
const lain = serupa.length ? serupa : proyek.filter((x) => x.slug !== p.slug).slice(0, 3);
const pesan = `Halo ${perusahaan.nama}, saya lihat proyek ${p.nama} dan mau konsultasi untuk proyek serupa.`;
---

<BangunLayout title={p.nama} description={p.ringkas}>
  <section class="relative isolate overflow-hidden bg-accent text-white">
    <Foto
      nama={p.foto}
      prioritas
      class="absolute inset-0 -z-20 h-full w-full"
      widths={[800, 1400, 2000]}
      sizes="100vw"
    />
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-accent via-accent/60 to-accent/20" aria-hidden="true"></div>

    <div class="wrap pt-40 pb-10 sm:pt-56">
      <nav aria-label="Remah roti" class="text-sm text-white/70">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href={base} class="hover:text-white">Beranda</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`${base}/proyek`} class="hover:text-white">Proyek</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-white">{p.nama}</li>
        </ol>
      </nav>
      <p class="mt-5 text-xs font-semibold tracking-[0.18em] text-brand-light uppercase">
        {jenis} · {p.lokasi}
      </p>
      <h1 class="mt-2 max-w-3xl font-display text-5xl leading-none font-bold text-white uppercase sm:text-7xl">
        {p.nama}
      </h1>
    </div>
  </section>

  <section class="border-b border-line">
    <dl class="tabular wrap grid grid-cols-2 gap-y-5 py-6 sm:grid-cols-4">
      {
        [
          ['Luas', p.luas],
          ['Nilai kontrak', p.nilai],
          ['Durasi', p.durasi],
          ['Selesai', String(p.tahun)],
        ].map(([k, v]) => (
          <div>
            <dt class="text-[11px] tracking-wide text-ink-muted uppercase">{k}</dt>
            <dd class="font-display text-2xl leading-tight font-bold">{v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap grid gap-10 py-14 lg:grid-cols-[1.4fr_1fr]">
    <div>
      <h2 class="font-display text-3xl font-bold uppercase">Gambaran proyek</h2>
      <p class="mt-3 text-lg text-ink-muted">{p.ringkas}</p>

      <h2 class="mt-10 font-display text-3xl font-bold uppercase">Tantangannya</h2>
      <p class="mt-3 text-ink-muted">{p.tantangan}</p>

      <h2 class="mt-10 font-display text-3xl font-bold uppercase">Hasilnya</h2>
      <p class="mt-3 text-ink-muted">{p.hasil}</p>
    </div>

    <aside class="h-fit border border-line p-6 lg:sticky lg:top-32">
      <p class="text-[11px] tracking-wide text-ink-muted uppercase">Klien</p>
      <p class="font-semibold">{p.klien}</p>
      <p class="mt-5 text-[11px] tracking-wide text-ink-muted uppercase">Lokasi</p>
      <p class="font-semibold">{p.lokasi}</p>

      <hr class="my-6 border-line" />

      <p class="font-display text-2xl leading-tight font-bold uppercase">
        Punya proyek serupa?
      </p>
      <p class="mt-2 text-sm text-ink-muted">
        Survei lokasi gratis, RAB awal dalam tujuh hari kerja.
      </p>
      <a
        href={`https://wa.me/${perusahaan.whatsapp}?text=${encodeURIComponent(pesan)}`}
        target="_blank"
        rel="noopener"
        class="mt-4 flex min-h-12 items-center justify-center bg-brand px-6 text-sm font-semibold tracking-wide text-white uppercase hover:bg-brand-strong"
      >
        Konsultasi sekarang
      </a>
    </aside>
  </section>

  <section class="bg-surface-alt py-14">
    <div class="wrap">
      <h2 class="font-display text-3xl font-bold uppercase">Proyek lainnya</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {lain.map((x) => <KartuProyek proyek={x} />)}
      </div>
    </div>
  </section>
</BangunLayout>
