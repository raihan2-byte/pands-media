---
import BangunLayout from '../../../layouts/BangunLayout.astro';
import { perusahaan, layanan } from '../../../data/bangun-karya';
---

<BangunLayout
  title="Kontak & Minta Survei"
  description="Hubungi CV Bangun Karya untuk survei lokasi gratis dan RAB awal."
>
  <section class="bg-accent py-14 text-white">
    <div class="wrap">
      <p class="text-xs font-semibold tracking-[0.18em] text-brand-light uppercase">Kontak</p>
      <h1 class="mt-2 font-display text-5xl leading-none font-bold text-white uppercase sm:text-7xl">
        Minta survei gratis
      </h1>
      <p class="mt-4 max-w-xl text-white/70">
        Isi yang kamu tahu saja. Sisanya kami tanyakan saat survei.
      </p>
    </div>
  </section>

  <section class="wrap grid gap-12 py-14 lg:grid-cols-[1.3fr_1fr]">
    <form id="form" novalidate class="flex flex-col gap-5">
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="nama" class="text-sm font-semibold">
            Nama <span class="text-brand">*</span>
          </label>
          <input
            id="nama"
            name="nama"
            type="text"
            autocomplete="name"
            class="mt-1.5 h-12 w-full border border-line-strong bg-surface px-4 outline-none focus:border-brand"
          />
        </div>
        <div>
          <label for="telepon" class="text-sm font-semibold">
            Nomor WhatsApp <span class="text-brand">*</span>
          </label>
          <input
            id="telepon"
            name="telepon"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            placeholder="081234567890"
            class="mt-1.5 h-12 w-full border border-line-strong bg-surface px-4 outline-none focus:border-brand"
          />
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="layanan" class="text-sm font-semibold">Jenis pekerjaan</label>
          <select
            id="layanan"
            name="layanan"
            class="mt-1.5 h-12 w-full border border-line-strong bg-surface px-3 outline-none focus:border-brand"
          >
            {layanan.map((l) => <option value={l.nama}>{l.nama}</option>)}
          </select>
        </div>
        <div>
          <label for="anggaran" class="text-sm font-semibold">Perkiraan anggaran</label>
          <select
            id="anggaran"
            name="anggaran"
            class="mt-1.5 h-12 w-full border border-line-strong bg-surface px-3 outline-none focus:border-brand"
          >
            <option>Belum tahu</option>
            <option>Di bawah Rp500 juta</option>
            <option>Rp500 juta – Rp2 miliar</option>
            <option>Rp2 – Rp10 miliar</option>
            <option>Di atas Rp10 miliar</option>
          </select>
        </div>
      </div>

      <div>
        <label for="lokasi" class="text-sm font-semibold">
          Lokasi proyek <span class="text-brand">*</span>
        </label>
        <input
          id="lokasi"
          name="lokasi"
          type="text"
          placeholder="Kota atau kecamatan"
          class="mt-1.5 h-12 w-full border border-line-strong bg-surface px-4 outline-none focus:border-brand"
        />
      </div>

      <div>
        <label for="cerita" class="text-sm font-semibold">Ceritakan kebutuhanmu</label>
        <textarea
          id="cerita"
          name="cerita"
          rows="5"
          placeholder="Misalnya: renovasi dapur dan tambah satu kamar, lahan 8 × 15 m"
          class="mt-1.5 w-full border border-line-strong bg-surface px-4 py-3 outline-none focus:border-brand"
        ></textarea>
      </div>

      <p id="salah" role="alert" hidden class="text-sm font-semibold text-brand-strong"></p>

      <div class="flex flex-wrap items-center gap-4">
        <button
          type="submit"
          class="min-h-13 bg-brand px-8 text-sm font-semibold tracking-wide text-white uppercase hover:bg-brand-strong"
        >
          Kirim lewat WhatsApp
        </button>
        <p class="text-xs text-ink-muted">
          Datamu tidak disimpan. Isian disusun jadi pesan WhatsApp yang bisa
          kamu periksa dulu.
        </p>
      </div>
    </form>

    <aside class="flex flex-col gap-6">
      <div class="border border-line p-6">
        <h2 class="font-display text-2xl font-bold uppercase">Kantor</h2>
        <address class="mt-3 leading-relaxed text-ink-muted not-italic">
          {perusahaan.alamat}<br />
          {perusahaan.telepon}<br />
          {perusahaan.email}
        </address>
        <p class="mt-3 text-sm text-ink-muted">{perusahaan.jam}</p>
      </div>

      {/* Peta digambar, bukan disematkan. Demo tidak memanggil layanan luar. */}
      <div class="relative min-h-52 overflow-hidden border border-line bg-surface-alt" aria-hidden="true">
        <svg viewBox="0 0 320 200" class="h-full w-full">
          <rect width="320" height="200" fill="var(--color-surface-alt)"></rect>
          <path d="M0 140h320M110 0v200M0 70h320M230 0v200" stroke="var(--color-surface)" stroke-width="12"></path>
          <path d="M0 70h320M110 0v200" stroke="var(--color-line-strong)" stroke-width="1"></path>
          <rect x="125" y="82" width="60" height="44" fill="var(--color-line)"></rect>
          <rect x="245" y="30" width="50" height="30" fill="var(--color-line)"></rect>
          <rect x="20" y="86" width="70" height="40" fill="var(--color-line)"></rect>
          <rect x="143" y="68" width="24" height="24" fill="var(--color-brand)"></rect>
          <rect x="151" y="76" width="8" height="8" fill="var(--color-surface)"></rect>
        </svg>
        <p class="absolute bottom-3 left-3 bg-surface px-3 py-1.5 text-xs font-semibold">
          {perusahaan.nama} · {perusahaan.kota}
        </p>
      </div>
    </aside>
  </section>
</BangunLayout>

<script define:vars={{ wa: perusahaan.whatsapp, nama: perusahaan.nama }}>
  const form = document.getElementById('form');
  const salah = document.getElementById('salah');

  function tampilkan(teks) {
    salah.textContent = teks;
    salah.hidden = teks === '';
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(form));

    if (String(d.nama).trim().length < 3) return tampilkan('Tulis nama, minimal 3 huruf.');
    if (!/^0\d{8,13}$/.test(String(d.telepon).replace(/[\s-]/g, '')))
      return tampilkan('Tulis nomor WhatsApp aktif, contoh 081234567890.');
    if (String(d.lokasi).trim().length < 3) return tampilkan('Tulis lokasi proyek.');
    tampilkan('');

    const pesan = [
      `Halo ${nama}, saya mau minta survei:`,
      '',
      `Nama: ${d.nama}`,
      `WhatsApp: ${d.telepon}`,
      `Jenis pekerjaan: ${d.layanan}`,
      `Anggaran: ${d.anggaran}`,
      `Lokasi: ${d.lokasi}`,
      d.cerita ? `Kebutuhan: ${d.cerita}` : null,
    ]
      .filter(Boolean)
      .join('\n');

    window.open(`https://wa.me/${wa}?text=${encodeURIComponent(pesan)}`, '_blank', 'noopener');
  });
</script>
