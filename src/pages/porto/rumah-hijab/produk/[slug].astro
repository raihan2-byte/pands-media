---
import HijabLayout from '../../../../layouts/HijabLayout.astro';
import Foto from '../../../../components/demos/rumah-hijab/Foto.astro';
import ProductCard from '../../../../components/demos/rumah-hijab/ProductCard.astro';
import PilihVarian from '../../../../components/demos/rumah-hijab/PilihVarian.tsx';
import { produk, kategori, rupiah, toko } from '../../../../data/rumah-hijab';

export function getStaticPaths() {
  return produk.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const base = '/porto/rumah-hijab';
const namaKategori = kategori.find((k) => k.slug === p.kategori)!.nama;
const lainnya = produk.filter((x) => x.kategori === p.kategori && x.slug !== p.slug).slice(0, 4);
const diskon = p.hargaCoret ? Math.round((1 - p.harga / p.hargaCoret) * 100) : 0;
---

<HijabLayout title={p.nama} description={p.ringkas}>
  <div class="wrap py-6">
    <nav aria-label="Remah roti" class="text-sm text-ink-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={base} class="hover:text-brand">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={`${base}/produk?jenis=${p.kategori}`} class="hover:text-brand">
            {namaKategori}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">{p.nama}</li>
      </ol>
    </nav>

    <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div>
        <Foto
          slug={p.slug}
          prioritas
          class="aspect-4/5 rounded-card"
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 560px, 100vw"
        />

        {
          lainnya.length > 0 && (
            <div class="mt-3 grid grid-cols-4 gap-2" aria-hidden="true">
              {lainnya.slice(0, 4).map((x) => (
                <Foto
                  slug={x.slug}
                  class="aspect-square rounded-control"
                  widths={[160, 320]}
                  sizes="120px"
                  alt=""
                />
              ))}
            </div>
          )
        }
      </div>

      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="text-xs font-semibold tracking-[0.14em] text-ink-muted uppercase">
          {namaKategori}
        </p>
        <h1 class="mt-2 font-display text-3xl leading-tight sm:text-4xl">{p.nama}</h1>

        <p class="mt-3 flex items-center gap-2 text-sm text-ink-muted">
          <span class="flex" aria-hidden="true">
            {
              [1, 2, 3, 4, 5].map((i) => (
                <svg
                  viewBox="0 0 20 20"
                  class:list={['size-4', i <= Math.round(p.rating) ? 'fill-accent' : 'fill-line']}
                >
                  <path d="M10 1.8l2.4 5 5.5.8-4 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4-4-3.8 5.5-.8 2.4-5z" />
                </svg>
              ))
            }
          </span>
          <span class="tabular">{p.rating.toFixed(1)}</span>
          <span>({p.ulasan} ulasan)</span>
          <span aria-hidden="true">·</span>
          <span class="tabular">{p.terjual.toLocaleString('id-ID')} terjual</span>
        </p>

        <p class="mt-5 flex flex-wrap items-baseline gap-3">
          <span class="tabular font-display text-3xl text-brand">{rupiah(p.harga)}</span>
          {
            p.hargaCoret && (
              <>
                <span class="tabular text-ink-muted line-through">{rupiah(p.hargaCoret)}</span>
                <span class="rounded-full bg-brand-soft px-2.5 py-1 text-xs font-bold text-brand-strong">
                  Hemat {diskon}%
                </span>
              </>
            )
          }
        </p>

        <p class="mt-4 text-ink-muted">{p.ringkas}</p>

        <div class="mt-6 border-t border-line pt-6">
          {/* Pulau React. Hanya bagian ini yang mengirim JavaScript. */}
          <PilihVarian client:load produk={p} />
        </div>

        <dl class="mt-6 flex flex-col gap-2 border-t border-line pt-5 text-sm">
          <div class="flex gap-3">
            <dt class="w-24 shrink-0 text-ink-muted">Bahan</dt>
            <dd>{p.bahan}</dd>
          </div>
          <div class="flex gap-3">
            <dt class="w-24 shrink-0 text-ink-muted">Pengiriman</dt>
            <dd>Dikirim dari {toko.kota}, hari itu juga bila pesan sebelum 15.00</dd>
          </div>
          <div class="flex gap-3">
            <dt class="w-24 shrink-0 text-ink-muted">Tukar</dt>
            <dd>Boleh ditukar dalam 3 hari setelah paket diterima</dd>
          </div>
        </dl>

        <div class="mt-6 rounded-card bg-surface-alt p-5">
          <h2 class="font-display text-lg">Keterangan</h2>
          <p class="mt-2 text-sm text-ink-muted">{p.deskripsi}</p>
        </div>
      </div>
    </div>

    {
      lainnya.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-2xl">Masih satu kategori</h2>
          <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4">
            {lainnya.map((x) => (
              <ProductCard produk={x} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</HijabLayout>
