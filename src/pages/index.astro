---
import { getCollection } from 'astro:content';
import PandsLayout from '../layouts/PandsLayout.astro';
import Hero from '../components/pands/Hero.astro';
import DemoCard from '../components/pands/DemoCard.astro';
import Proses from '../components/pands/Proses.astro';
import Harga from '../components/pands/Harga.astro';
import CtaWhatsApp from '../components/pands/CtaWhatsApp.astro';
import { site } from '../site';

/*
  Arah "Bukti Dulu": hero pendek, lalu grid demo langsung.
  Demo yang sudah siap tampil lebih dulu, baru yang masih dibangun.
*/
const demos = (await getCollection('demos')).sort((a, b) => {
  const siap = Number(b.data.status === 'siap') - Number(a.data.status === 'siap');
  return siap !== 0 ? siap : a.data.urutan - b.data.urutan;
});

---

<PandsLayout title={`${site.nama} — ${site.tagline}`} rootTitle>
  <Hero jumlahJenis={demos.length} />

  <section id="porto" class="wrap pb-14 sm:pb-20">
    <div class="flex items-end justify-between gap-4 border-t border-line pt-8">
      <div>
        <h2 class="text-2xl sm:text-3xl">Yang bisa kami kerjakan</h2>
        <p class="mt-2 max-w-xl text-ink-muted">
          Tiap kartu adalah demo utuh dengan nama usaha fiktif. Buka, klik-klik,
          pakai seperti punya sendiri.
        </p>
      </div>
      <a
        href="/porto"
        class="hidden shrink-0 py-1 text-sm font-semibold text-brand hover:text-brand-strong sm:block"
      >
        Semua demo
      </a>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
      {demos.map((demo) => <DemoCard demo={demo} />)}
    </div>

    <p class="mt-6 sm:hidden">
      <a href="/porto" class="inline-block py-1 text-sm font-semibold text-brand">Semua demo &rarr;</a>
    </p>
  </section>

  <Proses />
  <Harga />
  <CtaWhatsApp />
</PandsLayout>
