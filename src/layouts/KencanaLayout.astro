---
import DemoLayout from './DemoLayout.astro';
import ShopHeader from '../components/demos/kencana-print/ShopHeader.astro';
import ShopFooter from '../components/demos/kencana-print/ShopFooter.astro';
import { toko } from '../data/kencana-print';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<DemoLayout
  brand={toko.nama}
  brandToken="kencana-print"
  domainPalsu={toko.domain}
  title={title}
  description={description}
>
  <ShopHeader />
  <main>
    <slot />
  </main>
  <ShopFooter />
</DemoLayout>
