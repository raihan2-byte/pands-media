---
import DemoLayout from './DemoLayout.astro';
import { perusahaan, jenisProyek, WA_PESAN } from '../data/bangun-karya';

/* Barlow Condensed hanya dimuat di situs kontraktor ini. Hurufnya sempit dan
   tebal seperti papan nama proyek, memberi kesan kokoh tanpa banyak hiasan. */
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = '/porto/bangun-karya';
const path = Astro.url.pathname;
const aktif = (h: string) => (h === base ? path === base || path === `${base}/` : path.startsWith(h));

const nav = [
  { label: 'Beranda', href: base },
  { label: 'Proyek', href: `${base}/proyek` },
  { label: 'Kontak', href: `${base}/kontak` },
];
const wa = `https://wa.me/${perusahaan.whatsapp}?text=${encodeURIComponent(WA_PESAN)}`;
---

<DemoLayout
  brand={perusahaan.nama}
  brandToken="bangun-karya"
  domainPalsu={perusahaan.domain}
  title={title}
  description={description}
>
  <header class="sticky top-11 z-30 border-b border-line bg-surface">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={base} class="flex items-center gap-2.5">
        <span
          class="grid size-9 place-items-center bg-brand font-display text-lg leading-none font-bold text-white"
          aria-hidden="true">BK</span
        >
        <span class="font-display text-xl leading-none font-bold tracking-wide uppercase">
          Bangun Karya
        </span>
      </a>

      <nav aria-label="Navigasi utama" class="hidden items-center gap-1 md:flex">
        {
          nav.map((n) => (
            <a
              href={n.href}
              aria-current={aktif(n.href) ? 'page' : undefined}
              class:list={[
                'border-b-2 px-3 py-2 text-sm font-semibold tracking-wide uppercase',
                aktif(n.href)
                  ? 'border-brand text-ink'
                  : 'border-transparent text-ink-muted hover:text-ink',
              ]}
            >
              {n.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={`${base}/proyek`}
          class="inline-flex min-h-11 items-center px-3 text-sm font-semibold tracking-wide uppercase md:hidden"
        >
          Proyek
        </a>
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center rounded-control bg-brand px-4 text-sm font-semibold tracking-wide text-white uppercase hover:bg-brand-strong"
        >
          Konsultasi
        </a>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="bg-accent text-white">
    <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-display text-2xl font-bold tracking-wide uppercase">{perusahaan.nama}</p>
        <p class="mt-2 max-w-sm text-sm text-white/65">
          {perusahaan.tagline}. Kontraktor bangunan dan sipil di Jawa Tengah
          sejak {perusahaan.berdiri}.
        </p>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-[0.14em] text-white/50 uppercase">Kantor</h2>
        <address class="mt-3 text-sm leading-relaxed text-white/80 not-italic">
          {perusahaan.alamat}<br />
          {perusahaan.telepon}<br />
          {perusahaan.email}<br />
          {perusahaan.jam}
        </address>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-[0.14em] text-white/50 uppercase">Jenis proyek</h2>
        <ul class="mt-3 flex flex-col gap-1 text-sm">
          {
            jenisProyek.map((j) => (
              <li>
                <a
                  href={`${base}/proyek?jenis=${j.slug}`}
                  class="inline-block py-1 text-white/80 hover:text-white"
                >
                  {j.nama}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10">
      <p class="wrap py-5 text-xs text-white/55">
        Situs ini mockup buatan
        <a href="/porto" class="font-semibold text-white">Pands Media</a>. Nama
        perusahaan, klien, proyek, dan angka di dalamnya fiktif.
      </p>
    </div>
  </footer>
</DemoLayout>
